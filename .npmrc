# react-native 0.88.0-rc.0 is a prerelease, and npm's semver does not treat a
# prerelease as satisfying a plain range like ">=0.71.0". Several RN libraries
# declare peers that way, so a default `npm install` fails with ERESOLVE even
# though the versions are compatible. Drop this once RN is on a stable release.
legacy-peer-deps=true
